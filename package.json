{
  "name": "stratus",
  "version": "0.1.0",
  "description": "Multi-region status page on Cloudflare Workers: per-region probes, incidents, team notifications and subscriptions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealos-tech/stratus.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-shape": "^3.2.0",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
